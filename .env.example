# ── Gemini AI (Worker + Verifier Agents) ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Option A: Single Connection String (Render PostgreSQL / Cloud DB)
DATABASE_URL=postgresql://trustuser:trustpass@postgres:5432/trustdb
# Option B: Individual connection parameters (Local Docker / Custom DB)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trustdb
DB_USER=trustuser
DB_PASSWORD=trustpass
DB_SSLMODE=prefer

# ── Google OAuth Client ID ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── Inter-Service Agent URLs (Used by Client Agent) ─────────────────────────
WORKER_URL=http://worker-agent:8001
VERIFIER_URL=http://verifier-agent:8002
ESCROW_URL=http://escrow-service:8003

# ── CORS Frontend Allowed Origin ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

