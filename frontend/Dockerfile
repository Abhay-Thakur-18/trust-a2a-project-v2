FROM node:20-alpine

WORKDIR /app

ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_CLIENT_AGENT_URL
ARG VITE_WORKER_AGENT_URL
ARG VITE_VERIFIER_AGENT_URL
ARG VITE_ESCROW_SERVICE_URL

ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_CLIENT_AGENT_URL=$VITE_CLIENT_AGENT_URL
ENV VITE_WORKER_AGENT_URL=$VITE_WORKER_AGENT_URL
ENV VITE_VERIFIER_AGENT_URL=$VITE_VERIFIER_AGENT_URL
ENV VITE_ESCROW_SERVICE_URL=$VITE_ESCROW_SERVICE_URL

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

EXPOSE 4173

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]
